{
  "_comment": "Reference template for .claude/settings.local.json after /onboard v2.8 in --local-only mode (default). v2.8: every onboard-written hook block and the env section carry _onboard_managed markers — these are the basis for /onboard --uninstall surgical removal. Standard JSON parsers ignore unknown fields. This file is Claude Code's per-user override, conventionally NOT committed. Hook paths reference the user-global skill install (~/.claude/skills/onboard/) so the project tree stays untouched. If you installed onboard as a project-shared skill, replace ~/.claude with ${CLAUDE_PROJECT_DIR}/.claude in the four hook command paths.",

  "env": {
    "ONBOARD_FORBIDDEN_PATHS": "packages/legacy-core:vendor",
    "ONBOARD_TOUCHED_LOG": "${CLAUDE_PROJECT_DIR}/.claude/local-only/onboarding-logs/touched-files.txt",
    "ONBOARD_STOP_MODE": "light",
    "ONBOARD_STACKS_FILE": "${CLAUDE_PROJECT_DIR}/.claude/local-only/onboarding-logs/stacks.json",
    "_onboard_managed_env_keys": ["ONBOARD_FORBIDDEN_PATHS", "ONBOARD_TOUCHED_LOG", "ONBOARD_STOP_MODE", "ONBOARD_STACKS_FILE"]
  },

  "hooks": {
    "PreToolUse": [
      {
        "_onboard_managed": true,
        "_onboard_version": "2.8",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/skills/onboard/hooks/guard-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "_onboard_managed": true,
        "_onboard_version": "2.8",
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/skills/onboard/hooks/guard-edit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_onboard_managed": true,
        "_onboard_version": "2.8",
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/skills/onboard/hooks/post-edit-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "_onboard_managed": true,
        "_onboard_version": "2.8",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/skills/onboard/hooks/stop-verify.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
